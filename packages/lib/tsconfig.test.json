{
    "compilerOptions": {
        "target": "es2019",
        "module": "commonjs",
        "moduleResolution": "node",
        "strict": false,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "types": [
            "jest",
            "node"
        ],
        "baseUrl": ".",
        "paths": {
            "@repo/types": [
                "../types/src"
            ],
            "@repo/shared": [
                "../shared/src"
            ],
            "@repo/ui": [
                "../ui/src"
            ]
        }
    },
    "include": [
        "src/__tests__/**/*.ts"
    ]
}