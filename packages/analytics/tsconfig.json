{
    "compilerOptions": {
        "target": "es2019",
        "module": "commonjs",
        "moduleResolution": "node",
        "lib": [
            "es2019"
        ],
        "strict": false,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "declaration": true,
        "outDir": "dist",
        "noEmit": true,
        "baseUrl": ".",
        "paths": {
            "@repo/types": [
                "../types/src"
            ],
            "@repo/shared": [
                "../shared/src"
            ]
        }
    },
    "include": [
        "src/**/*"
    ]
}